{
  "name": "save-token",
  "version": "0.1.0",
  "type": "module",
  "description": "Token optimizer for CodeBuddy - diagnose, analyze, optimize token usage",
  "author": {
    "name": "studyzy",
    "url": "https://github.com/studyzy"
  },
  "license": "MIT",
  "main": "dist/cli.mjs",
  "module": "dist/cli.mjs",
  "types": "dist/cli.d.mts",
  "bin": {
    "st": "bin/st.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "dev": "tsx ./src/cli.ts",
    "build": "unbuild",
    "start": "node bin/st.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "prepare": "husky"
  },
  "dependencies": {
    "ansis": "^3.9.0",
    "cac": "^6.7.14",
    "dayjs": "^1.11.13",
    "fs-extra": "^11.2.0",
    "i18next": "^23.16.0",
    "i18next-fs-backend": "^2.6.0",
    "inquirer": "^12.3.0",
    "inquirer-toggle": "^1.0.1",
    "ora": "^8.1.0",
    "pathe": "^1.1.2",
    "semver": "^7.6.3",
    "tinyexec": "^0.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^22.10.0",
    "@types/semver": "^7.5.8",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.16.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.62.1",
    "unbuild": "^3.0.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18"
  }
